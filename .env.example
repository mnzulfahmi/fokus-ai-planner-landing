# Server-only Google Gemini API credentials. Never use NEXT_PUBLIC_ for this key.
GOOGLE_API_KEY=

# Stable Gemini model used for task analysis and priority ranking.
GEMINI_MODEL=gemini-3.6-flash

# Server-only InsForge admin connection used by /api/workspace.
# Local development can fall back to the linked .insforge/project.json file.
INSFORGE_URL=https://your-project.region.insforge.app
INSFORGE_API_KEY=
